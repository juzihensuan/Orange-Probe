NODE_ENV=production
PORT=4174
DATA_DIR=/app/data
PROBE_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
AGENT_TOKEN_ENCRYPTION_KEY=
# 仅填写实际反向代理的地址或 CIDR；不要使用 0.0.0.0/0 或 ::/0。
TRUST_PROXY=loopback, linklocal, uniquelocal
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=4174
DEPLOY_PATH=/opt/orange-probe
COMPOSE_PROJECT_NAME=orange-probe
DATA_MOUNT=orange-probe-data
ORANGE_PROBE_TAG=latest
UPDATE_TOKEN=replace-with-a-long-random-update-token
GITHUB_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
PROBE_SERVER_URL=http://127.0.0.1:4174
PROBE_TRANSPORT=http
PROBE_WS_URL=ws://127.0.0.1:4174/agent-ws
PROBE_NAME=My Server
PROBE_AUTO_REGION=true
PROBE_REGION=
PROBE_TAGS=production,api
REPORT_INTERVAL=3000
AGENT_DATA_DIR=
AGENT_LOG_RETENTION_DAYS=7
