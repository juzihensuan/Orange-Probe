{
  "name": "orange-probe",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A lightweight real-time server monitoring dashboard and probe agent.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "docker:build": "docker compose build",
    "start": "node server/index.js",
    "agent": "node agent/index.js",
    "check": "tsc -b && node --check server/index.js && node --check agent/index.js && node --check agent/updater.js && node --check updater/index.js",
    "test:smoke": "node scripts/smoke-test.mjs",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "express": "^5.1.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.468.0",
    "proxy-addr": "^2.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
